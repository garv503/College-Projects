<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         id="WebApp_ID" version="4.0">

  <display-name>E-Notes</display-name>

  <!-- The React build's entry point. Servlets and filters are declared by
       annotation (@WebServlet / @WebFilter) in com.api and com.filter. -->
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

  <session-config>
    <session-timeout>60</session-timeout>
    <cookie-config>
      <!-- The session cookie is only ever used by same-origin fetch calls, so
           it never needs to be readable by script or sent cross-site. -->
      <http-only>true</http-only>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

</web-app>
