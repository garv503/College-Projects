# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials - the previous
# version of this project had the MySQL password committed inside
# backend/db_config.py, which puts it in the git history permanently.
#
# ONE FILE, BOTH WAYS OF RUNNING
# ------------------------------
# Docker Compose also reads this file, to substitute the ${...} values in
# docker-compose.yml - so DB_PASSWORD and JWT_SECRET are shared between
# `python backend/app.py` and `docker compose up`.
#
# DB_HOST and DB_PORT below apply to the terminal path only. Inside a
# container the API always talks to `db:3306`, because the compose file
# sets those explicitly rather than substituting them. That is deliberate:
# it means "localhost" here cannot break the containers.

# --- Database (terminal path) ----------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foresight
DB_POOL_SIZE=5

# --- Host ports (Docker path) ----------------------------------------
# Only used by docker-compose.yml. Change these to run the containers
# alongside a locally running server or a local MySQL.
APP_PORT=5000
DB_HOST_PORT=3307

# --- Authentication --------------------------------------------------
# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it invalidates every issued token, which is exactly what you
# want if one leaks.
JWT_SECRET=dev-secret-change-me
JWT_TTL_MINUTES=120

# --- Login rate limiting ---------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- Server ----------------------------------------------------------
DEBUG=true
HOST=127.0.0.1
PORT=5000

# Comma-separated list of origins allowed to call the API from a browser.
# `*` is fine locally. With DEBUG=false the app refuses to start on `*`.
CORS_ORIGINS=*

# --- Academic rules --------------------------------------------------
# The thresholds the analytics use. Kept as configuration because
# different institutions set different bars.
PASS_PERCENT=40
MIN_ATTENDANCE_PERCENT=75
