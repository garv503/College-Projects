# Copy this file to .env (project root) to configure the Docker Compose run.
# A terminal run is configured by server/.env instead. Both connect to the same
# MySQL, so both show the same accounts and notes. This file is gitignored.

# Host port for the app. Defaults to 3001 so it does not collide with a
# terminal run on 3000.
APP_PORT=3001

# Absolute base URL. Defaults to http://localhost:$APP_PORT.
# APP_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Database - the MySQL installed on this machine.
#
# host.docker.internal is how a container reaches the machine it runs on;
# `localhost` there would mean the container itself. These must match the
# DB_* values in server/.env, since they are the same database.
# ---------------------------------------------------------------------------
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=enotes

# Signs the session cookie. Use a long random value for anything beyond
# local use - anyone who knows it can forge a session.
SESSION_SECRET=change-me-to-a-long-random-string

# Marks the session cookie HTTPS-only. Must stay false while the app is
# reached over plain http://localhost - a Secure cookie is dropped over HTTP,
# which makes sign-in appear to succeed while every later request is anonymous.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Outgoing email - the registration verification code
#
# Leave MAIL_HOST blank and the code is printed to `docker compose logs app`
# instead of being sent. For Gmail, MAIL_PASSWORD must be a 16-character App
# Password, not the account password.
# ---------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Inkwell <no-reply@inkwell.local>
