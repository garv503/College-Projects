# Copy this file to server/.env and fill in your values.
# server/.env is gitignored - it is never committed.
#
# This configures a TERMINAL run. The Docker Compose stack is configured by
# the .env file in the project root instead - see .env.example there.

PORT=3000

# Absolute base URL this instance is reached at. Change it when deploying.
APP_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_NAME=enotes
DB_PASSWORD=your_password_here

# Signs the session cookie. Use a long random value; anyone who knows it can
# forge a session. Required when NODE_ENV=production.
SESSION_SECRET=change-me-to-a-long-random-string

# Marks the session cookie HTTPS-only. Leave false while running over plain
# http://localhost - a Secure cookie is dropped over HTTP, which makes sign-in
# appear to succeed while every later request is anonymous. Set it to true once
# HTTPS terminates in front of the app.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Outgoing email - the registration verification code
#
# Leave MAIL_HOST blank and the code is printed to the server console instead
# of being sent, which is enough to complete a signup locally.
#
# For Gmail: enable 2-Step Verification on the account, then create an App
# Password (Google Account -> Security -> App passwords) and use that as
# MAIL_PASSWORD. A normal account password will not work.
# ---------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Inkwell <no-reply@inkwell.local>
