# Copy this file to server/.env and fill in your values.
# server/.env is gitignored - it is never committed.

PORT=3000

# Absolute base URL, used to build links inside emails (which cannot be
# relative). Change this when deploying.
APP_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_NAME=enotes
DB_PASSWORD=your_password_here

# Signs the session cookie. Use a long random value; anyone who knows it can
# forge a session. Required when NODE_ENV=production.
SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Google sign-in (optional)
#
# Leave blank to switch it off - the button is then hidden rather than shown
# and broken. To enable it:
#   1. https://console.cloud.google.com/ -> create or pick a project
#   2. APIs & Services -> OAuth consent screen -> configure it (External is fine)
#   3. APIs & Services -> Credentials -> Create credentials
#        -> OAuth client ID -> Application type: Web application
#   4. Under "Authorised JavaScript origins" add exactly:
#        http://localhost:3000
#      (add your real origin too when you deploy)
#   5. Copy the Client ID below. The client *secret* is not needed: this app
#      verifies Google ID tokens rather than running a redirect flow.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Outgoing email (optional)
#
# Leave MAIL_HOST blank and emails are printed to the server console instead of
# being sent, which is enough to click through the account-setup link locally.
#
# For Gmail: enable 2-Step Verification on the account, then create an App
# Password (Google Account -> Security -> App passwords) and use that as
# MAIL_PASSWORD. A normal account password will not work.
# ---------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Inkwell <no-reply@inkwell.local>
